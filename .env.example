# Copie ce fichier vers .env.local et remplis les valeurs. Ne commite jamais .env.local.
# Ajoute les mêmes variables dans Vercel, puis redéploie.

# Webhook Make qui reçoit les leads (achat_commence, ebook) et les achats (achat_complete).
MAKE_WEBHOOK_URL=

# Adresse du site, sans barre à la fin. Sert au lien dans l'ebook.
NEXT_PUBLIC_SITE_URL=

# Pixel Meta. Vide = rien ne charge. Vérification : ajoute ?debug_pixel=1 à l'adresse.
NEXT_PUBLIC_META_PIXEL_ID=

# Vidéo verticale (fichier .mp4) du hero et de /ebook/merci. Vide = bloc vidéo caché. L'aperçu va dans public/video-poster.jpg.
# Optionnel : par défaut, /video.mp4 (public/video.mp4)
NEXT_PUBLIC_HERO_VIDEO_URL=

# Stripe. En test : clés sk_test_ / pk_test_. En production : sk_live_ / pk_live_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret de signature (whsec_) du webhook Stripe vers /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
