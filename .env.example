# Copie ce fichier vers .env.local et remplis les valeurs. Ne commite jamais .env.local.
# Ajoute les mêmes variables dans Vercel (avec les valeurs du mode réel).

# Webhook Make qui reçoit les leads et les achats (achat_commence, ebook, achat_complete).
MAKE_WEBHOOK_URL=

# Stripe. En test : sk_test_... / En réel : sk_live_...
STRIPE_SECRET_KEY=
# Produit « Touch Grass Academy : les 8 modules », 87 $ CAD, paiement unique : price_...
STRIPE_PRICE_ID=
# En local : donné par « stripe listen ». En ligne : celui de l'endpoint Stripe. whsec_...
STRIPE_WEBHOOK_SECRET=

# Liens affichés sur la page /merci.
DISCORD_INVITE_URL=
COURSE_URL=

# Adresse du site, sans barre à la fin. En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=
